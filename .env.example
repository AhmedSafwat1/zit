# ---------- Compose host ports (docker-compose.yml) ----------
PG_PORT=5434
REDIS_PORT=6380
AMQP_PORT=5672
AMQP_MGMT_PORT=15672

# ---------- App ----------
APP_NAME=identity-gateway
APP_ENV=development            # development | staging | production (production hides /swagger)
APP_VERSION=dev
APP_DEBUG=false                # true: error responses carry error.debug.cause (+stack on panic). Dev only.

# ---------- HTTP server ----------
SERVER_PORT=8081
SERVER_PPROF_PORT=6060         # internal pprof listener on 127.0.0.1; 0 disables
SERVER_WORKER_PORT=8082        # worker health/ready listener
SERVER_WORKER_PPROF_PORT=6061  # worker pprof listener
SERVER_READ_TIMEOUT=5s
SERVER_WRITE_TIMEOUT=10s       # also the per-request context timeout
SERVER_IDLE_TIMEOUT=120s
SERVER_SHUTDOWN_TIMEOUT=15s
SERVER_MAX_BODY_BYTES=1048576
SERVER_RATE_LIMIT_RPS=0        # per-IP token bucket on /api/v1; 0 disables
SERVER_RATE_LIMIT_BURST=0

# ---------- Postgres (worker; API opens it only when DB_HOST is set) ----------
DB_HOST=localhost
DB_PORT=5434
DB_USER=identity
DB_PASSWORD=identity
DB_NAME=identity
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=16
DB_MAX_IDLE_CONNS=4
DB_CONN_MAX_LIFETIME=30m

# ---------- Redis ----------
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=64
REDIS_MIN_IDLE_CONNS=8
REDIS_READ_TIMEOUT=300ms
REDIS_DIAL_TIMEOUT=1s

# ---------- Cache ----------
CACHE_KEY_PREFIX=zit:          # namespace for every Redis key; changing it = one-time cold cache
CACHE_INTROSPECT_TTL=120s      # cached identity report
CACHE_INACTIVE_TTL=30s         # negative cache for 400/401 tokens
CACHE_SYNC_DEDUPE_TTL=1h       # sync:seen:<sub> dedupe window
CACHE_USER_TTL=300s            # read-through user:<sub>
CACHE_TTL_JITTER=0.15          # +/- fraction applied to every write TTL

# ---------- RabbitMQ ----------
QUEUE_URL=amqp://guest:guest@localhost:5672/
QUEUE_EXCHANGE=zit.events
QUEUE_PUBLISH_TIMEOUT=500ms
QUEUE_CONFIRM=true
QUEUE_PREFETCH=64
QUEUE_CONCURRENCY=8
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY=1s           # backoff: 1s -> 5s -> 25s

# ---------- Zitadel ----------
ZITADEL_ISSUER=https://zauth.4ja.org
ZITADEL_USERINFO_PATH=/oidc/v1/userinfo
ZITADEL_TIMEOUT=3s
ZITADEL_RETRIES=1

# ---------- Circuit breaker (shared thresholds + per-integration switch) ----------
HTTP_CIRCUIT_BREAKER_MAX_REQUESTS=1
HTTP_CIRCUIT_BREAKER_INTERVAL=60s
HTTP_CIRCUIT_BREAKER_OPEN_TIMEOUT=15s
HTTP_CIRCUIT_BREAKER_CONSECUTIVE_FAILURES=5
ZITADEL_CIRCUIT_BREAKER_ENABLED=false

# ---------- Logging ----------
LOG_LEVEL=info                 # trace | debug | info | warn | error
LOG_FORMAT=json                # json | console
LOG_SAMPLE_RATE=100            # keep 1 in N successful access logs; 4xx/5xx always logged
